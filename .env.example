# Copy this file to .env and fill in your keys.
# .env is gitignored - never commit real keys.

# build.nvidia.com -> any vision model page -> "Get API Key"
NVIDIA_API_KEY=nvapi-...

# aistudio.google.com -> Get API key -> Create API key
GEMINI_API_KEY=...

# Only needed if NOT using your existing Claude Code subscription
# (i.e. only if you route Claude Code through OpenRouter instead)
# OPENROUTER_API_KEY=sk-or-v1-...
