# Copy this file to .env and fill in your keys.
# .env is gitignored - never commit real keys.
#
# All four below are used as interchangeable model providers INSIDE our own
# pipeline (captioning/VQA/answer generation) - not related to how Claude Code
# itself is authenticated. Fill in whichever you set up; scripts/check_setup.py
# will test whichever keys are present and skip the rest.

# build.nvidia.com -> any vision model page -> "Get API Key"
# Good primary candidate for bulk per-chunk captioning: ~40 req/min free, no card.
# NOTE: meta/llama-3.2-90b-vision-instruct (the prereqs guide's example model) hung
# indefinitely when tested - key/network/catalog were all confirmed fine via raw curl,
# the 90B model's endpoint itself just didn't respond (likely overloaded on the free tier,
# possibly every team following the same guide hits this exact model). Use
# meta/llama-3.2-11b-vision-instruct instead - responded in <1s and is a better fit for
# bulk captioning anyway. If it ever hangs too, GET /v1/models lists what's currently live.
NVIDIA_API_KEY=nvapi-...

# aistudio.google.com -> Get API key -> Create API key
# Unique capability: accepts raw video directly (no frame extraction needed).
# Best used as query-time fallback / "cheat mode", not bulk indexing.
GEMINI_API_KEY=...

# openrouter.ai -> API Keys -> Create key
# Only needed here if you want it as a PIPELINE model provider (captioning/VQA).
# (Separately, OpenRouter can also route Claude Code itself - see the prereqs
# guide - but that's unrelated and not needed since Claude Code already has
# your subscription.) Free-model availability rotates; check
# https://openrouter.ai/models?max_price=0 if the default below stops working.
OPENROUTER_API_KEY=sk-or-v1-...

# console.groq.com -> API Keys -> Create API Key
# Fast inference, free tier, vision-capable Llama models. Good low-latency
# option for demo-time answer generation.
GROQ_API_KEY=gsk_...

# kaggle.com -> Settings -> API -> Create New Token
# NOTE: as of this Kaggle CLI version (2.2.4), auth is a SINGLE token, not the classic
# kaggle.json username+key pair from older docs/tutorials - don't be misled by those.
# The token (prefixed KGAT_) must be saved to ~/.kaggle/access_token (or exported as
# KAGGLE_API_TOKEN) for the `kaggle` CLI itself to pick it up - this .env entry is just
# our own single-place record; KAGGLE_USERNAME isn't actually required for auth but is
# handy to have on file.
KAGGLE_USERNAME=...
KAGGLE_API_TOKEN=...
